<Window x:Class="AutoverhuurProject.Presentatie.Gui.Gebr.ReserverenApp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoverhuurProject.Presentatie.Gui.Gebr"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Reservatie maken" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="NaamIngelogdeKlantTextBlock" Grid.Row="0" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
        <ListView Grid.Row="1" x:Name="VestigingenListView" Grid.ColumnSpan="3">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Land" Width="Auto" DisplayMemberBinding="{Binding Land}" />
                    <GridViewColumn Header="Luchthaven" Width="Auto" DisplayMemberBinding="{Binding Luchthaven}" />
                    <GridViewColumn Header="Plaats" Width="Auto" DisplayMemberBinding="{Binding Plaats}" />
                    <GridViewColumn Header="Postcode" Width="Auto" DisplayMemberBinding="{Binding Postcode}" />
                    <GridViewColumn Header="Straat" Width="Auto" DisplayMemberBinding="{Binding Straat}" />
                </GridView>
            </ListView.View>
        </ListView>
        <ListView x:Name="AutosListView" Grid.Column="1" Grid.Row="3">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Model" Width="Auto" DisplayMemberBinding="{Binding Model}" />
                    <GridViewColumn Header="Zitplaatsen" Width="Auto" DisplayMemberBinding="{Binding Zitplaatsen}" />
                    <GridViewColumn Header="Motortype" Width="Auto" DisplayMemberBinding="{Binding Motortype}" />
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Row="2" Grid.Column="0">
            <StackPanel Margin="10">
                <TextBlock Text="Startdatum" />
                <DatePicker x:Name="StartDatumDatePicker"/>
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock Text="Einddatum" />
                <DatePicker x:Name="EindDatumDatePicker"/>
            </StackPanel>
            <StackPanel Margin="10">
                <Button x:Name="ZoekAutosButton" Content="Zoeken" Click="ZoekAutosButton_Click"/>
            </StackPanel>
            <StackPanel Margin="10">
                <Button x:Name="VorigeButton" Content="Vorige" Click="VorigeButton_Click"/>
            </StackPanel>

        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2" Margin="5">
            <StackPanel Margin="10">
                <TextBlock Text="Aantal personen (niet verplicht)"/>
                <TextBox x:Name="AantalPersonenTextBox"/>
            </StackPanel>
            <StackPanel Margin="5">
                <Button x:Name="MaakReservatieButton" Content="Plaats reservatie" Click="MaakReservatieButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>