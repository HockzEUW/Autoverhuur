<Window x:Class="AutoverhuurProject.Presentatie.Gui.Gebr.LoginApp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoverhuurProject.Presentatie.Gui.Gebr"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Login" Height="450" Width="800">
    <Grid>
        <Grid.Resources>
            <Style TargetType="DockPanel">
                <Setter Property="Margin" Value="5" />
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel>
                <StackPanel>
                    <Label Content="Kies een klant om een reservatie te maken." FontWeight="Bold"/>
                </StackPanel>
                <StackPanel>
                    <Label Content="Zoekterm"/>
                    <TextBox x:Name="ZoektermTextBox"/>
                </StackPanel>
                <StackPanel>
                    <Button x:Name="ZoekButton" Content="Zoeken" Margin="10" Click="ZoekButton_Click"/>
                </StackPanel>
                <StackPanel>
                    <Button x:Name="InlogButton" Content="Inloggen" Margin="10" Click="InlogButton_Click"/>
                </StackPanel>
                <StackPanel>
                    <Button x:Name="VorigeButton" Content="Vorige" Margin="10" Click="VorigeButton_Click"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <ListView x:Name="KlantenListView" SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Voornaam" Width="75" DisplayMemberBinding="{Binding Voornaam}" />
                        <GridViewColumn Header="Naam" Width="150" DisplayMemberBinding="{Binding Achternaam}"/>
                        <GridViewColumn Header="Email" Width="250" DisplayMemberBinding="{Binding Email}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Grid>
</Window>