<Window x:Class="AutoverhuurProject.Presentatie.Gui.Gebr.AutoOverzichtApp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoverhuurProject.Presentatie.Gui.Gebr"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Beschikbare auto's" Height="450" Width="800">
    <Grid>
        <Grid.Resources>
            <Style TargetType="DockPanel">
                <Setter Property="Margin" Value="5" />
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <StackPanel>
                <StackPanel>
                    <Label Content="Zoek naar beschikbare auto's" HorizontalAlignment="Center" FontWeight="Black"/>
                </StackPanel>
                <StackPanel>
                    <Label Content="Vestigingen:"/>
                    <ComboBox x:Name="VestigingenComboBox"  DisplayMemberPath="Luchthaven"/>
                </StackPanel>
                <StackPanel>
                    <Label Content="Startdatum:"/>
                    <DatePicker x:Name="ReservatieStartDatumDatePicker" IsTodayHighlighted="True"/>
                </StackPanel>
                <StackPanel>
                    <Label Content="Einddatum:"/>
                    <DatePicker x:Name="ReservatieEindDatumDatePicker" IsTodayHighlighted="True"/>
                </StackPanel>
                <StackPanel>
                    <Button x:Name="ZoekButton" Content="Zoeken" Margin="10" Click="ZoekButton_Click"/>
                </StackPanel>
                <StackPanel>
                    <Button x:Name="ExporterenButton" Content="Exporteren naar ADOC" Margin="10" Click="ExporterenButton_Click"/>
                </StackPanel>
                <StackPanel>
                    <Button x:Name="VorigeButton" Content="Vorige" Margin="10" Click="VorigeButton_Click"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <ListView x:Name="AutosListView" SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Model" Width="Auto" DisplayMemberBinding="{Binding Model}" />
                        <GridViewColumn Header="Nummerplaat" Width="Auto" DisplayMemberBinding="{Binding Nummerplaat}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Grid>
</Window>
